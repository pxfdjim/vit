    "matching": {
      "top_k": 5,
      "lambda": 0.3,
      "distance": "clamped_cosine",
      "calibration": "unlabeled_reference_distance_statistics",
      "modified_visual_scale": "base_patch_only",
      "keep_other_visual_scales": true
    },
    "harmonic": {
      "implementation": "stable",
      "retain_legacy_for_comparison": true,
      "count_fix_as_model_contribution": false
