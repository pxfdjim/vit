  "evaluation": {
    "alphas": [0.1, 0.01, 0.001],
    "threshold_method": "mean",
    "smoothing": true,
    "sliding": false,
    "anomaly_padding": 0,
    "selection_protocol": "For each dataset, variant, and alpha, first take the unweighted mean of per-signal contextual F1. Select the alpha with the largest mean. Macro average the seven selected dataset F1 values.",
